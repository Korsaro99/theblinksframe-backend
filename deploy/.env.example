# Production secrets and versions for deploy/compose.yaml. On the VM only, as
# ~/the-blinks/prod/.env, readable by you alone (chmod 600). Never commit the real file.
# deploy/README.md, "Secrets", shows how to make each value without it showing on screen.

# --- Versions (the git commit each image was built from: `make publish` prints it) ---------
BACKEND_TAG=
# A production frontend build, never demo-*.
WEB_TAG=

# --- Database ------------------------------------------------------------------------------
# Owner login (migrations, backups). openssl rand -hex 32
POSTGRES_PASSWORD=
# The API's login (data only). Hex, because it goes inside a URL. openssl rand -hex 32
# Used once, when the database is first created; changing it later needs ALTER ROLE (README).
APP_DB_PASSWORD=

# --- API -----------------------------------------------------------------------------------
# openssl rand -base64 48. Changing it ends every access token; the admin refreshes silently.
JWT_SECRET=

# First OWNER account. Set all three for the first start only, then delete all three lines
# and run `sudo docker compose up -d api` (README, "First owner account").
OWNER_BOOTSTRAP_NAME=
OWNER_BOOTSTRAP_PHONE=
OWNER_BOOTSTRAP_PASSWORD=

# --- Cloudflare Tunnel -----------------------------------------------------------------------
# The token of the tunnel blinks-prod (README, "Create the tunnel"). Starts with eyJ.
TUNNEL_TOKEN=
