# Copy to .env for local development: cp .env.example .env
# The Makefile loads .env automatically. In production, set these in the host's environment.

# --- API ---------------------------------------------------------------------
# development | test | production
APP_ENV=development
HTTP_ADDR=:8080
# How long in-flight requests get to finish on shutdown (Go duration).
SHUTDOWN_TIMEOUT=15s

# debug | info | warn | error
LOG_LEVEL=info
# json | text (default: json in production, text otherwise)
LOG_FORMAT=text

# Comma-separated frontend origins allowed to call the API with cookies. Required in production.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Database ----------------------------------------------------------------
# Used by the API (Go/pgx format). Must match the POSTGRES_* values below locally.
DATABASE_URL=postgres://blinks:blinks@localhost:5432/blinks?sslmode=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5

# Used by docker-compose for the local Postgres container and the Liquibase runner.
POSTGRES_DB=blinks
POSTGRES_USER=blinks
POSTGRES_PASSWORD=blinks
POSTGRES_PORT=5432

# Added in later milestones: JWT signing key and token lifetimes (M2), media storage (M2),
# payment provider keys (M4, TODO(open): Paystack or Hubtel), notification sender (M5).
