# Copy to .env for local development: cp .env.example .env
# The Makefile loads .env automatically. In production, set these in the host's environment.

# --- API ---------------------------------------------------------------------
# development | test | production
APP_ENV=development
HTTP_ADDR=:8080
# How long in-flight requests get to finish on shutdown (Go duration).
SHUTDOWN_TIMEOUT=15s

# debug | info | warn | error
LOG_LEVEL=info
# json | text (default: json in production, text otherwise)
LOG_FORMAT=text

# Comma-separated frontend origins allowed to call the API with cookies. Required in production:
# https://theblinksframes.com (www redirects to it at Cloudflare, so it never calls the API).
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Comma-separated IPs or CIDRs of reverse proxies whose X-Forwarded-For header is trusted. Leave
# empty when nothing sits in front of the API; set it behind a proxy, or every client shares the
# proxy's IP in the login rate limit. Production: the Cloudflare tunnel container (deploy/compose.yaml).
TRUSTED_PROXIES=

# --- Admin auth --------------------------------------------------------------
# Signs access tokens and CSRF tokens. At least 32 bytes. Generate with: openssl rand -base64 48
# Production refuses to start with this example value.
JWT_SECRET=dev-only-not-a-secret-replace-me-with-openssl-rand
# Secure cookies are sent over HTTPS only. Chrome and Firefox accept them on http://localhost;
# set false only if your browser (e.g. Safari) drops them locally. Only allowed in development.
COOKIE_SECURE=true
# Parent domain shared by the site and the API. Production: theblinksframes.com. Empty for localhost.
COOKIE_DOMAIN=

# First OWNER account, created on startup only if there is no OWNER yet. It never changes an
# existing account. Set all three for the first start, then remove OWNER_BOOTSTRAP_PASSWORD.
# Password: 12 to 72 bytes.
OWNER_BOOTSTRAP_NAME=
OWNER_BOOTSTRAP_PHONE=
OWNER_BOOTSTRAP_PASSWORD=

# --- Database ----------------------------------------------------------------
# Used by the API (Go/pgx format). Must match the POSTGRES_* values below locally.
DATABASE_URL=postgres://blinks:blinks@localhost:5432/blinks?sslmode=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5

# Used by docker-compose for the local Postgres container and the Liquibase runner.
POSTGRES_DB=blinks
POSTGRES_USER=blinks
POSTGRES_PASSWORD=blinks
POSTGRES_PORT=5432

# Added in later milestones: media storage (M2), payment provider keys
# (M4, TODO(open): Paystack or Hubtel), notification sender (M5).
